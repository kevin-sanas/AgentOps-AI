# Compose physical data volumes retain the original prefix across the product rename.
# For an existing custom installation, set this to its previous Compose project name.
# New isolated installations may choose a unique prefix. Never share a prefix between stacks.
DAWNWATCH_DATA_PREFIX=agentops-platform

# Fill locally; .env is ignored. Do not use these field names as secret values.
DB_USER=agentops
DB_PASSWORD=
SESSION_TOKEN_PEPPER=
AGENT_INTERNAL_TOKEN=
SESSION_DURATION=PT30M
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=
BACKEND_PORT=18080
FRONTEND_PORT=5174
# Compose-only isolated checkpoint cluster; different owner/application passwords.
CHECKPOINT_OWNER_PASSWORD=
CHECKPOINT_PASSWORD=
KUMA_PORT=3001
# DeepSeek is configured after login under AI 故障诊断 → 模型配置与用量.
# Never place the model API key in this file or a process environment variable.
# Java Outbox dispatcher. False keeps queued runs paused until explicitly enabled.
AGENT_ENABLED=false
AGENT_SERVICE_ORIGIN=http://127.0.0.1:8090
# Python only: separate database and non-superuser role, never the Java business DB URL.
AGENT_CHECKPOINT_DSN=
MONITORING_ENABLED=true
# Deployment egress envelope; empty denies all private targets. Comma-separated RFC1918/ULA CIDRs only.
MONITOR_ALLOWED_PRIVATE_CIDRS=
# Optional deployment-owned Kuma origin; mapping stores only env:KUMA_PUSH_TOKEN_* references.
KUMA_ENABLED=false
KUMA_BASE_URL=
KUMA_ALLOW_HTTP=false
KUMA_ALLOWED_PRIVATE_CIDRS=
KUMA_PUSH_TOKEN_DEMO=
